                          <object class="GtkBox" id="voice_recording_bar">
                            <property name="spacing">8</property>
                            <style>
                              <class name="chat-input-bar"/>
                              <class name="voice-recording-bar"/>
                            </style>
                            <child>
                              <object class="GtkButton" id="voice_delete_btn">
                                <property name="icon-name">user-trash-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Delete recording</property>
                                <property name="valign">3</property>
                                <style>
                                  <class name="flat"/>
                                  <class name="circular"/>
                                  <class name="voice-delete-btn"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkImage" id="voice_status_icon">
                                <property name="icon-name">media-record-symbolic</property>
                                <property name="valign">3</property>
                                <style>
                                  <class name="voice-record-pulse"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="voice_timer_label">
                                <property name="label">0:00</property>
                                <property name="valign">3</property>
                                <style>
                                  <class name="voice-timer-label"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkDrawingArea" id="voice_meter_area">
                                <property name="hexpand">true</property>
                                <property name="valign">3</property>
                                <property name="height-request">28</property>
                                <style>
                                  <class name="voice-meter-area"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="voice_pause_btn">
                                <property name="icon-name">media-playback-pause-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Pause recording</property>
                                <property name="valign">3</property>
                                <style>
                                  <class name="flat"/>
                                  <class name="circular"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="voice_stop_btn">
                                <property name="icon-name">media-playback-stop-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Stop recording</property>
                                <property name="valign">3</property>
                                <style>
                                  <class name="flat"/>
                                  <class name="circular"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="voice_play_btn">
                                <property name="icon-name">media-playback-start-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Play preview</property>
                                <property name="valign">3</property>
                                <property name="visible">false</property>
                                <style>
                                  <class name="flat"/>
                                  <class name="circular"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="voice_send_btn">
                                <property name="icon-name">mail-send-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Send voice message</property>
                                <property name="valign">3</property>
                                <property name="visible">false</property>
                                <style>
                                  <class name="suggested-action"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>