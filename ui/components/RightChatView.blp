using Gtk 4.0;
using Adw 1;

Adw.ToolbarView right_chat_view {
  [top]
  Adw.HeaderBar {
    title-widget: Gtk.Button active_chat_btn {
      valign: center;
      styles ["flat", "active-chat-btn"]
      tooltip-text: _("View contact details and shared media");

      child: Gtk.Box {
        spacing: 10;
        valign: center;

        Adw.Avatar active_chat_avatar {
          size: 34;
          show-initials: true;
        }

        Adw.WindowTitle active_chat_title {
          title: "WhatsDown";
        }

        Gtk.Image {
          icon-name: "go-next-symbolic";
          valign: center;
          styles ["dim-label", "active-chat-chevron"]
        }
      };
    };

    [end]
    Gtk.ToggleButton chat_search_btn {
      icon-name: "edit-find-symbolic";
      tooltip-text: _("Search messages in this conversation");
      valign: center;
    }
  }

  [top]
  Gtk.SearchBar chat_search_bar {
    child: Gtk.Box {
      orientation: horizontal;
      spacing: 6;

      Gtk.SearchEntry chat_search_entry {
        placeholder-text: _("Search in conversation…");
        hexpand: true;
      }

      Gtk.Label chat_search_count_label {
        label: "";
        styles ["dim-label", "caption"]
      }

      Gtk.Button chat_search_prev_btn {
        icon-name: "go-up-symbolic";
        tooltip-text: _("Previous match");
        styles ["flat"]
      }

      Gtk.Button chat_search_next_btn {
        icon-name: "go-down-symbolic";
        tooltip-text: _("Next match");
        styles ["flat"]
      }
    };
  }

  content: Gtk.Stack content_stack {
    Gtk.StackPage {
      name: "empty";
      child: Adw.StatusPage empty_status_page {
        icon-name: "chat-message-new-symbolic";
        title: _("No Chat Selected");
        description: _("Select a chat from the sidebar to view messages.");
      };
    }

    Gtk.StackPage {
      name: "settings";
      child: Adw.StatusPage settings_status_page {
        icon-name: "preferences-system-symbolic";
        title: _("Settings");
        description: _("Manage your account and preferences.");
      };
    }

    Gtk.StackPage {
      name: "chat";
      child: Gtk.Box chat_page {
        orientation: vertical;
        styles ["chat-page"]

        Gtk.Overlay {
          vexpand: true;
          hexpand: true;

          child: Gtk.ScrolledWindow messages_scrolled_window {
            hscrollbar-policy: never;
            vscrollbar-policy: automatic;
            vexpand: true;

            Gtk.ListBox messages_list {
              selection-mode: none;
              margin-bottom: 12;
              styles ["chat-messages-list"]
            }
          };

          [overlay]
          Gtk.Button scroll_to_bottom_btn {
            icon-name: "go-down-symbolic";
            tooltip-text: _("Scroll to bottom");
            halign: end;
            valign: end;
            margin-end: 14;
            margin-bottom: 14;
            visible: false;
            styles ["circular", "suggested-action", "scroll-bottom-fab"]
          }
        }

        Gtk.Box typing_indicator_bar {
          visible: false;
          orientation: horizontal;
          halign: start;
          margin-start: 16;
          margin-top: 2;
          margin-bottom: 4;
          styles ["typing-indicator-container"]

          Gtk.Box {
            orientation: horizontal;
            spacing: 5;
            styles ["typing-indicator-bubble"]

            Gtk.Label typing_dot_1 {
              label: "●";
              styles ["typing-dot", "typing-dot-1"]
            }

            Gtk.Label typing_dot_2 {
              label: "●";
              styles ["typing-dot", "typing-dot-2"]
            }

            Gtk.Label typing_dot_3 {
              label: "●";
              styles ["typing-dot", "typing-dot-3"]
            }
          }
        }

        Gtk.Box edit_banner_bar {
          visible: false;
          orientation: horizontal;
          spacing: 8;
          styles ["reply-preview-bar"]

          Gtk.Image {
            icon-name: "document-edit-symbolic";
            valign: center;
            styles ["dim-label"]
          }

          Gtk.Box {
            orientation: vertical;
            spacing: 2;
            hexpand: true;

            Gtk.Label {
              label: _("Editing message");
              xalign: 0;
              styles ["reply-preview-sender"]
            }

            Gtk.Label edit_banner_text {
              xalign: 0;
              ellipsize: end;
              max-width-chars: 60;
              styles ["reply-preview-text"]
            }
          }

          Gtk.Button cancel_edit_btn {
            icon-name: "window-close-symbolic";
            tooltip-text: _("Cancel editing");
            valign: center;
            styles ["flat", "circular", "reply-cancel-btn"]
          }
        }

        Gtk.Box reply_preview_bar {
          visible: false;
          orientation: horizontal;
          spacing: 8;
          styles ["reply-preview-bar"]

          Gtk.Box {
            orientation: vertical;
            spacing: 2;
            hexpand: true;

            Gtk.Label reply_preview_sender {
              xalign: 0;
              styles ["reply-preview-sender"]
            }

            Gtk.Label reply_preview_text {
              xalign: 0;
              wrap: true;
              wrap-mode: word_char;
              lines: 3;
              ellipsize: end;
              styles ["reply-preview-text"]
            }
          }

          Gtk.Button cancel_reply_btn {
            icon-name: "window-close-symbolic";
            tooltip-text: _("Cancel reply");
            valign: center;
            styles ["flat", "circular", "reply-cancel-btn"]
          }
        }

        Gtk.Box markdown_preview_bar {
          visible: false;
          orientation: horizontal;
          spacing: 8;
          styles ["markdown-preview-bar"]

          Gtk.Image {
            icon-name: "format-text-bold-symbolic";
            valign: center;
            styles ["dim-label"]
          }

          Gtk.Label {
            label: _("Preview:");
            valign: center;
            styles ["caption", "dim-label"]
          }

          Gtk.Label markdown_preview_label {
            hexpand: true;
            xalign: 0;
            wrap: true;
            wrap-mode: word_char;
            use-markup: true;
            styles ["markdown-preview-text"]
          }
        }

        Gtk.Box emoji_suggestion_bar {
          visible: false;
          orientation: horizontal;
          halign: start;
          spacing: 4;
          styles ["emoji-suggestion-bar"]
        }

        Gtk.Stack chat_input_stack {
          transition-type: crossfade;

          Gtk.StackPage {
            name: "normal";
            child: Gtk.Box chat_input_bar {
              spacing: 8;
              styles ["chat-input-bar"]

              Gtk.MenuButton attach_button {
                icon-name: "mail-attachment-symbolic";
                tooltip-text: _("Attach");
                valign: end;
                styles ["flat", "circular", "chat-attach-btn"]

                popover: Gtk.Popover attach_popover {
                  child: Gtk.Box {
                    orientation: vertical;
                    spacing: 4;
                    margin-top: 6;
                    margin-bottom: 6;
                    margin-start: 6;
                    margin-end: 6;

                    Gtk.Button attach_photo_btn {
                      valign: center;
                      styles ["flat"]
                      child: Gtk.Box {
                        spacing: 10;
                        Gtk.Image {
                          icon-name: "insert-image-symbolic";
                        }
                        Gtk.Label {
                          label: _("Photos & Videos");
                        }
                      };
                    }

                    Gtk.Button attach_doc_btn {
                      valign: center;
                      styles ["flat"]
                      child: Gtk.Box {
                        spacing: 10;
                        Gtk.Image {
                          icon-name: "folder-documents-symbolic";
                        }
                        Gtk.Label {
                          label: _("Document");
                        }
                      };
                    }

                    Gtk.Button attach_poll_btn {
                      valign: center;
                      tooltip-text: _("Create a poll");
                      styles ["flat"]
                      child: Gtk.Box {
                        spacing: 10;
                        Gtk.Image {
                          icon-name: "view-list-bullet-symbolic";
                        }
                        Gtk.Label {
                          label: _("Poll");
                        }
                      };
                    }

                    Gtk.Button attach_location_btn {
                      valign: center;
                      sensitive: false;
                      tooltip-text: _("Location sharing coming soon");
                      styles ["flat"]
                      child: Gtk.Box {
                        spacing: 10;
                        Gtk.Image {
                          icon-name: "mark-location-symbolic";
                        }
                        Gtk.Label {
                          label: _("Location");
                        }
                      };
                    }
                  };
                };
              }

              Gtk.MenuButton emoji_button {
                icon-name: "face-smile-symbolic";
                tooltip-text: _("Emojis");
                valign: end;
                styles ["flat", "circular", "chat-attach-btn"]

                popover: Gtk.EmojiChooser emoji_chooser {
                };
              }

              Gtk.MenuButton sticker_button {
                icon-name: "image-x-generic-symbolic";
                tooltip-text: _("Stickers");
                valign: end;
                styles ["flat", "circular", "chat-attach-btn"]

                popover: Gtk.Popover sticker_popover {
                  child: Gtk.Box {
                    orientation: vertical;
                    spacing: 8;
                    width-request: 320;
                    height-request: 360;
                    margin-top: 10;
                    margin-bottom: 10;
                    margin-start: 10;
                    margin-end: 10;

                    Gtk.Box {
                      orientation: horizontal;
                      spacing: 8;

                      Gtk.Label {
                        label: _("Saved Stickers");
                        hexpand: true;
                        xalign: 0;
                        styles ["heading"]
                      }

                      Gtk.Button add_sticker_btn {
                        icon-name: "list-add-symbolic";
                        tooltip-text: _("Add sticker from file…");
                        valign: center;
                        styles ["flat", "circular"]
                      }
                    }

                    Gtk.ScrolledWindow sticker_scrolled_window {
                      hscrollbar-policy: never;
                      vscrollbar-policy: automatic;
                      hexpand: true;
                      vexpand: true;

                      Gtk.FlowBox sticker_flowbox {
                        valign: start;
                        max-children-per-line: 4;
                        min-children-per-line: 4;
                        selection-mode: none;
                        row-spacing: 6;
                        column-spacing: 6;
                        styles ["sticker-flowbox"]
                      }
                    }

                    Gtk.Box sticker_empty_box {
                      orientation: vertical;
                      spacing: 8;
                      valign: center;
                      halign: center;
                      vexpand: true;
                      visible: false;

                      Gtk.Image {
                        icon-name: "image-x-generic-symbolic";
                        pixel-size: 48;
                        styles ["dim-label"]
                      }

                      Gtk.Label {
                        label: _("No saved stickers");
                        styles ["heading"]
                      }

                      Gtk.Label {
                        label: _("Click on any sticker in chat to save it,\nor click + to add from an image file.");
                        wrap: true;
                        justify: center;
                        styles ["caption", "dim-label"]
                      }
                    }
                  };
                };
              }

              Gtk.Overlay message_entry_overlay {
                hexpand: true;
                valign: end;

                child: Gtk.ScrolledWindow message_entry_scrolled {
                  hexpand: true;
                  vscrollbar-policy: never;
                  hscrollbar-policy: never;
                  propagate-natural-height: false;
                  height-request: 34;
                  styles ["message-entry-container"]

                  Gtk.TextView message_entry {
                    wrap-mode: word_char;
                    accepts-tab: false;
                    left-margin: 12;
                    right-margin: 12;
                    top-margin: 6;
                    bottom-margin: 6;
                    styles ["message-text-view"]
                  }
                };

                [overlay]
                Gtk.Label message_placeholder {
                  label: _("Type a message…");
                  halign: start;
                  valign: center;
                  margin-start: 12;
                  can-target: false;
                  styles ["dim-label", "message-placeholder"]
                }
              }

              Gtk.Button voice_record_btn {
                icon-name: "audio-input-microphone-symbolic";
                tooltip-text: _("Record voice message");
                valign: end;
                styles ["flat", "circular", "chat-attach-btn"]
              }

              Gtk.Button send_button {
                icon-name: "mail-send-symbolic";
                valign: end;
                styles ["suggested-action", "circular", "chat-send-btn"]
              }
            };
          }

          Gtk.StackPage {
            name: "recording";
            child: Gtk.Box voice_recording_bar {
              spacing: 8;
              styles ["chat-input-bar", "voice-recording-bar"]

              Gtk.Button voice_delete_btn {
                icon-name: "user-trash-symbolic";
                tooltip-text: _("Delete recording");
                valign: center;
                styles ["flat", "circular", "voice-delete-btn"]
              }

              Gtk.Image voice_status_icon {
                icon-name: "media-record-symbolic";
                valign: center;
                styles ["voice-record-pulse"]
              }

              Gtk.Label voice_timer_label {
                label: "0:00";
                valign: center;
                styles ["voice-timer-label"]
              }

              Gtk.DrawingArea voice_meter_area {
                hexpand: true;
                valign: center;
                height-request: 28;
                styles ["voice-meter-area"]
              }

              Gtk.Button voice_pause_btn {
                icon-name: "media-playback-pause-symbolic";
                tooltip-text: _("Pause recording");
                valign: center;
                styles ["flat", "circular"]
              }

              Gtk.Button voice_stop_btn {
                icon-name: "media-playback-stop-symbolic";
                tooltip-text: _("Stop recording");
                valign: center;
                styles ["flat", "circular"]
              }

              Gtk.Button voice_play_btn {
                icon-name: "media-playback-start-symbolic";
                tooltip-text: _("Play preview");
                valign: center;
                visible: false;
                styles ["flat", "circular"]
              }

              Gtk.Button voice_send_btn {
                icon-name: "mail-send-symbolic";
                tooltip-text: _("Send voice message");
                valign: center;
                visible: false;
                styles ["suggested-action"]
              }
            };
          }
        }
      };
    }
  };
}
