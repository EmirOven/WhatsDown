using Gtk 4.0;
using Adw 1;

Adw.ToolbarView chats_page {
  [top]
  Adw.HeaderBar {
    [start]
    Gtk.Button new_group_btn {
      icon-name: "list-add-symbolic";
      tooltip-text: _("Create New Group");
    }

    [end]
    Gtk.Button mark_all_read_btn {
      child: Adw.ButtonContent {
        icon-name: "mail-read-symbolic";
        label: _("Read All");
      };
      tooltip-text: _("Mark all unread chats as read");
      valign: center;
      sensitive: false;
      styles ["flat"]
    }

    title-widget: Adw.WindowTitle {
      title: "Chats";
    };
  }

  [top]
  Gtk.Box {
    orientation: vertical;
    margin-start: 8;
    margin-end: 8;
    margin-top: 2;
    margin-bottom: 6;

    Gtk.SearchEntry chats_search_entry {
      placeholder-text: _("Search users or chats…");
      hexpand: true;
    }
  }

  content: Gtk.ScrolledWindow {
    hscrollbar-policy: never;

    Gtk.ListBox chats_list {
      selection-mode: single;
      styles ["navigation-sidebar"]
    }
  };
}
