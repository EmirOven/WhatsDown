using Gtk 4.0;
using Adw 1;

Adw.ToolbarView calls_page {
  [top]
  Adw.HeaderBar {
    title-widget: Adw.WindowTitle {
      title: "Calls";
    };
  }

  [top]
  Gtk.Box {
    orientation: vertical;
    margin-start: 8;
    margin-end: 8;
    margin-top: 2;
    margin-bottom: 6;

    Gtk.SearchEntry calls_search_entry {
      placeholder-text: _("Search calls…");
      hexpand: true;
    }
  }

  content: Gtk.ScrolledWindow {
    hscrollbar-policy: never;

    Gtk.ListBox calls_list {
      selection-mode: single;
      styles ["navigation-sidebar"]
    }
  };
}
