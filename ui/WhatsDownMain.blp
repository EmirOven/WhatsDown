using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow main_window {
  default-width: 960;
  default-height: 640;
  title: "WhatsDown";

  content: Gtk.Box {
    orientation: horizontal;

    Gtk.Box nav_rail {
      orientation: vertical;
      spacing: 6;
      width-request: 68;
      styles ["navigation-rail"]

      Gtk.Button chats_nav_btn {
        tooltip-text: _("Chats");
        styles ["flat", "nav-rail-btn", "active"]
        child: Gtk.Box {
          orientation: vertical;
          spacing: 4;
          valign: center;
          halign: center;

          Gtk.Image {
            icon-name: "chat-message-new-symbolic";
            pixel-size: 22;
          }

          Gtk.Label {
            label: _("Chats");
            styles ["caption"]
          }
        };
      }

      Gtk.Button archived_nav_btn {
        tooltip-text: _("Archived");
        styles ["flat", "nav-rail-btn"]
        child: Gtk.Box {
          orientation: vertical;
          spacing: 4;
          valign: center;
          halign: center;

          Gtk.Image {
            icon-name: "folder-download-symbolic";
            pixel-size: 22;
          }

          Gtk.Label {
            label: _("Archived");
            styles ["caption"]
          }
        };
      }

      Gtk.Box {
        vexpand: true;
      }

      Gtk.Button settings_nav_btn {
        tooltip-text: _("Settings");
        styles ["flat", "nav-rail-btn"]
        child: Gtk.Box {
          orientation: vertical;
          spacing: 4;
          valign: center;
          halign: center;

          Gtk.Image {
            icon-name: "preferences-system-symbolic";
            pixel-size: 22;
          }

          Gtk.Label {
            label: _("Settings");
            styles ["caption"]
          }
        };
      }
    }

    Gtk.Separator {
      orientation: vertical;
    }

    Adw.NavigationSplitView split_view {
      hexpand: true;
      vexpand: true;
      min-sidebar-width: 280;
      max-sidebar-width: 400;

      sidebar: Adw.NavigationPage {
        title: "Chats";

        child: Gtk.Stack sidebar_stack {
          transition-type: crossfade;

          Gtk.StackPage {
            name: "chats";
            title: _("Chats");
            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                title-widget: Adw.WindowTitle {
                  title: "Chats";
                };
              }

              [top]
              Gtk.Box {
                orientation: vertical;
                margin-start: 8;
                margin-end: 8;
                margin-top: 2;
                margin-bottom: 6;

                Gtk.SearchEntry chats_search_entry {
                  placeholder-text: _("Search users or chats…");
                  hexpand: true;
                }
              }

              content: Gtk.ScrolledWindow {
                hscrollbar-policy: never;

                Gtk.ListBox chats_list {
                  selection-mode: single;
                  styles ["navigation-sidebar"]
                }
              };
            };
          }

          Gtk.StackPage {
            name: "archived";
            title: _("Archived");
            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                title-widget: Adw.WindowTitle {
                  title: "Archived Chats";
                };
              }

              [top]
              Gtk.Box {
                orientation: vertical;
                margin-start: 8;
                margin-end: 8;
                margin-top: 2;
                margin-bottom: 6;

                Gtk.SearchEntry archived_search_entry {
                  placeholder-text: _("Search archived chats…");
                  hexpand: true;
                }
              }

              content: Gtk.ScrolledWindow {
                hscrollbar-policy: never;

                Gtk.ListBox archived_chats_list {
                  selection-mode: single;
                  styles ["navigation-sidebar"]
                }
              };
            };
          }

          Gtk.StackPage {
            name: "settings";
            title: _("Settings");
            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                title-widget: Adw.WindowTitle {
                  title: "Settings";
                };
              }

              content: Gtk.ScrolledWindow {
                hscrollbar-policy: never;

                Gtk.Box {
                  orientation: vertical;
                  spacing: 16;
                  margin-top: 16;
                  margin-bottom: 24;
                  margin-start: 12;
                  margin-end: 12;

                  Adw.PreferencesGroup {
                    title: _("Account");

                    Adw.ActionRow settings_profile_row {
                      title: "WhatsApp User";
                      subtitle: "Connected";

                      [prefix]
                      Adw.Avatar settings_profile_avatar {
                        size: 44;
                        show-initials: true;
                      }
                    }
                  }

                  Adw.PreferencesGroup {
                    title: _("Sync & Devices");

                    Adw.ActionRow {
                      title: _("Sync with WhatsApp");
                      subtitle: _("Re-sync pinned & archived chats");

                      [prefix]
                      Gtk.Image {
                        icon-name: "view-refresh-symbolic";
                      }

                      [suffix]
                      Gtk.Button settings_resync_btn {
                        label: _("Sync Now");
                        valign: center;
                        styles ["suggested-action", "pill", "settings-action-btn"]
                      }
                    }
                  }

                  Adw.PreferencesGroup {
                    title: _("Storage & Data");

                    Adw.ActionRow settings_db_path_row {
                      title: _("Database Path");
                      subtitle: "~/.local/share/whatsdown/whatsdown.db";
                      subtitle-selectable: true;

                      [prefix]
                      Gtk.Image {
                        icon-name: "drive-harddisk-symbolic";
                      }
                    }

                    Adw.ActionRow settings_stats_row {
                      title: _("Stored Data");
                      subtitle: "0 chats • 0 messages";

                      [prefix]
                      Gtk.Image {
                        icon-name: "folder-documents-symbolic";
                      }
                    }

                    Adw.ActionRow {
                      title: _("Avatar Cache");
                      subtitle: _("Clear locally cached profile photos");

                      [prefix]
                      Gtk.Image {
                        icon-name: "folder-pictures-symbolic";
                      }

                      [suffix]
                      Gtk.Button settings_clear_cache_btn {
                        label: _("Clear");
                        valign: center;
                      }
                    }
                  }

                  Adw.PreferencesGroup {
                    title: _("Appearance");

                    Adw.ComboRow settings_theme_row {
                      title: _("Theme");
                      subtitle: _("Choose color scheme preference");

                      [prefix]
                      Gtk.Image {
                        icon-name: "preferences-desktop-appearance-symbolic";
                      }

                      model: Gtk.StringList {
                        strings [
                          _("System Default"),
                          _("Light"),
                          _("Dark"),
                        ]
                      };
                    }
                  }

                  Adw.PreferencesGroup {
                    title: _("Session");

                    Adw.ActionRow {
                      title: _("Log Out");
                      subtitle: _("Disconnect this computer from WhatsApp");

                      [prefix]
                      Gtk.Image {
                        icon-name: "system-log-out-symbolic";
                      }

                      [suffix]
                      Gtk.Button settings_logout_btn {
                        label: _("Log Out");
                        valign: center;
                        styles ["destructive-action"]
                      }
                    }
                  }

                  Adw.PreferencesGroup {
                    title: _("About");

                    Adw.ActionRow {
                      title: "WhatsDown";
                      subtitle: "Native Linux WhatsApp client built with Libadwaita & Go";

                      [prefix]
                      Gtk.Image {
                        icon-name: "help-about-symbolic";
                      }
                    }
                  }
                }
              };
            };
          }
        };
      };

      content: Adw.NavigationPage {
        title: "Conversation";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            title-widget: Gtk.Button active_chat_btn {
              valign: center;
              styles ["flat", "active-chat-btn"]
              tooltip-text: _("View contact details and shared media");

              child: Gtk.Box {
                spacing: 10;
                valign: center;

                Adw.Avatar active_chat_avatar {
                  size: 34;
                  show-initials: true;
                }

                Adw.WindowTitle active_chat_title {
                  title: "WhatsDown";
                }

                Gtk.Image {
                  icon-name: "go-next-symbolic";
                  valign: center;
                  styles ["dim-label", "active-chat-chevron"]
                }
              };
            };

            [end]
            Gtk.ToggleButton chat_search_btn {
              icon-name: "edit-find-symbolic";
              tooltip-text: _("Search messages in this conversation");
              valign: center;
            }
          }

          [top]
          Gtk.SearchBar chat_search_bar {
            child: Gtk.Box {
              orientation: horizontal;
              spacing: 6;

              Gtk.SearchEntry chat_search_entry {
                placeholder-text: _("Search in conversation…");
                hexpand: true;
              }

              Gtk.Label chat_search_count_label {
                label: "";
                styles ["dim-label", "caption"]
              }

              Gtk.Button chat_search_prev_btn {
                icon-name: "go-up-symbolic";
                tooltip-text: _("Previous match");
                styles ["flat"]
              }

              Gtk.Button chat_search_next_btn {
                icon-name: "go-down-symbolic";
                tooltip-text: _("Next match");
                styles ["flat"]
              }
            };
          }

          content: Gtk.Stack content_stack {
            Gtk.StackPage {
              name: "empty";
              child: Adw.StatusPage empty_status_page {
                icon-name: "chat-message-new-symbolic";
                title: _("No Chat Selected");
                description: _("Select a chat from the sidebar to view messages.");
              };
            }

            Gtk.StackPage {
              name: "settings";
              child: Adw.StatusPage settings_status_page {
                icon-name: "preferences-system-symbolic";
                title: _("Settings");
                description: _("Manage your WhatsApp account, synchronization, and app preferences.");
              };
            }

            Gtk.StackPage {
              name: "chat";
              child: Gtk.Box {
                orientation: vertical;

                Gtk.Overlay messages_overlay {
                  vexpand: true;

                  Gtk.ScrolledWindow messages_scrolled_window {
                    vexpand: true;
                    hscrollbar-policy: never;

                    Gtk.ListBox messages_list {
                      selection-mode: none;
                      styles ["messages-list"]
                    }
                  }

                  [overlay]
                  Gtk.Button scroll_to_bottom_btn {
                    icon-name: "go-bottom-symbolic";
                    tooltip-text: _("Scroll to bottom");
                    halign: end;
                    valign: end;
                    margin-end: 18;
                    margin-bottom: 14;
                    visible: false;
                    styles ["circular", "suggested-action", "scroll-bottom-fab"]
                  }
                }

                Gtk.Box {
                  spacing: 8;
                  styles ["chat-input-bar"]

                  Gtk.MenuButton attach_button {
                    icon-name: "mail-attachment-symbolic";
                    tooltip-text: _("Attach");
                    valign: center;
                    styles ["flat", "circular", "chat-attach-btn"]

                    popover: Gtk.Popover attach_popover {
                      child: Gtk.Box {
                        orientation: vertical;
                        spacing: 4;
                        margin-top: 6;
                        margin-bottom: 6;
                        margin-start: 6;
                        margin-end: 6;

                        Gtk.Button attach_photo_btn {
                          valign: center;
                          styles ["flat"]
                          child: Gtk.Box {
                            spacing: 10;
                            Gtk.Image {
                              icon-name: "insert-image-symbolic";
                            }
                            Gtk.Label {
                              label: _("Photos & Videos");
                            }
                          };
                        }

                        Gtk.Button attach_doc_btn {
                          valign: center;
                          styles ["flat"]
                          child: Gtk.Box {
                            spacing: 10;
                            Gtk.Image {
                              icon-name: "folder-documents-symbolic";
                            }
                            Gtk.Label {
                              label: _("Document");
                            }
                          };
                        }

                        Gtk.Button attach_poll_btn {
                          valign: center;
                          tooltip-text: _("Create a poll");
                          styles ["flat"]
                          child: Gtk.Box {
                            spacing: 10;
                            Gtk.Image {
                              icon-name: "view-list-bullet-symbolic";
                            }
                            Gtk.Label {
                              label: _("Poll");
                            }
                          };
                        }

                        Gtk.Button attach_location_btn {
                          valign: center;
                          sensitive: false;
                          tooltip-text: _("Location sharing coming soon");
                          styles ["flat"]
                          child: Gtk.Box {
                            spacing: 10;
                            Gtk.Image {
                              icon-name: "mark-location-symbolic";
                            }
                            Gtk.Label {
                              label: _("Location");
                            }
                          };
                        }
                      };
                    };
                  }

                  Gtk.Entry message_entry {
                    hexpand: true;
                    placeholder-text: _("Type a message…");
                  }

                  Gtk.Button send_button {
                    icon-name: "mail-send-symbolic";
                    styles ["suggested-action"]
                  }
                }
              };
            }
          };
        };
      };
    }
  };
}
