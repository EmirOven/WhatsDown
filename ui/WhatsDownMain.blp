using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow main_window {
  default-width: 960;
  default-height: 640;
  title: "WhatsDown";

  content: Adw.NavigationSplitView split_view {
    hexpand: true;
    vexpand: true;
    min-sidebar-width: 280;
    max-sidebar-width: 400;

    sidebar: Adw.NavigationPage sidebar_nav_page {
      title: "Chats";

      child: Adw.ToolbarView {
        content: Adw.ViewStack sidebar_stack {
        };

        [bottom]
        Adw.ViewSwitcherBar sidebar_switcher_bar {
          stack: sidebar_stack;
          reveal: true;
        }
      };
    };

    content: Adw.NavigationPage content_nav_page {
      title: "Conversation";
    };
  };
}
