using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow main_window {
  default-width: 960;
  default-height: 640;
  title: "WhatsDown";

  content: Gtk.Box {
    orientation: horizontal;

    Gtk.Box nav_rail {
      orientation: vertical;
      spacing: 6;
      width-request: 68;
      styles ["navigation-rail"]

      Gtk.Button chats_nav_btn {
        tooltip-text: _("Chats");
        styles ["flat", "nav-rail-btn", "active"]
        child: Gtk.Box {
          orientation: vertical;
          spacing: 4;
          valign: center;
          halign: center;

          Gtk.Image {
            icon-name: "chat-message-new-symbolic";
            pixel-size: 22;
          }

          Gtk.Label {
            label: _("Chats");
            styles ["caption"]
          }
        };
      }

      Gtk.Button archived_nav_btn {
        tooltip-text: _("Archived");
        styles ["flat", "nav-rail-btn"]
        child: Gtk.Box {
          orientation: vertical;
          spacing: 4;
          valign: center;
          halign: center;

          Gtk.Image {
            icon-name: "folder-download-symbolic";
            pixel-size: 22;
          }

          Gtk.Label {
            label: _("Archived");
            styles ["caption"]
          }
        };
      }

      Gtk.Box {
        vexpand: true;
      }

      Gtk.Button settings_nav_btn {
        tooltip-text: _("Settings");
        styles ["flat", "nav-rail-btn"]
        child: Gtk.Box {
          orientation: vertical;
          spacing: 4;
          valign: center;
          halign: center;

          Gtk.Image {
            icon-name: "preferences-system-symbolic";
            pixel-size: 22;
          }

          Gtk.Label {
            label: _("Settings");
            styles ["caption"]
          }
        };
      }
    }

    Gtk.Separator {
      orientation: vertical;
    }

    Adw.NavigationSplitView split_view {
      hexpand: true;
      vexpand: true;
      min-sidebar-width: 280;
      max-sidebar-width: 400;

      sidebar: Adw.NavigationPage sidebar_nav_page {
        title: "Chats";

        child: Gtk.Stack sidebar_stack {
          transition-type: crossfade;
        };
      };

      content: Adw.NavigationPage content_nav_page {
        title: "Conversation";
      };
    }
  };
}
