                                                        <child>
                                                          <object class="GtkLabel">
                                                            <property name="label" translatable="yes">Location</property>
                                                          </object>
                                                        </child>
                                                      </object>
                                                    </property>
                                                  </object>
                                                </child>
                                              </object>
                                            </property>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkEntry" id="message_entry">
                                        <property name="hexpand">true</property>
                                        <property name="placeholder-text" translatable="yes">Type a message…</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkButton" id="send_button">
                                        <property name="icon-name">mail-send-symbolic</property>
                                        <style>
                                          <class name="suggested-action"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>