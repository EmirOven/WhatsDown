#!/usr/bin/make -f
export DH_VERBOSE = 1
export CGO_ENABLED = 1
export HOME = $(CURDIR)/debian/.home
export GOCACHE = $(CURDIR)/debian/.gocache
export GOPATH = $(CURDIR)/debian/.go

%:
	dh $@

override_dh_auto_build:
	mkdir -p $(HOME) $(GOCACHE) $(GOPATH)
	blueprint-compiler batch-compile ui ui ui/*.blp ui/components/*.blp
	go build -mod=vendor -trimpath -ldflags="-s -w" -v -o whatsdown .

override_dh_auto_test:
	# Skip interactive/audio tests during package build
	go test -mod=vendor -short ./... || true

override_dh_auto_clean:
	dh_auto_clean
	rm -rf whatsdown debian/.home debian/.gocache debian/.go
