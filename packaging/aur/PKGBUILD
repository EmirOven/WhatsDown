# Maintainer: Emir Öven <emiroven@postbetasoftware.com>
pkgname=whatsdown-git
pkgver=0.1.0.r14.g10d5311
pkgrel=1
pkgdesc="Native Linux WhatsApp client built with GTK 4 and Libadwaita"
arch=('x86_64' 'aarch64')
url="https://github.com/EmirOven/WhatsDown"
license=('MIT')
depends=(
    'gtk4'
    'libadwaita'
    'sqlite'
    'hicolor-icon-theme'
)
makedepends=(
    'git'
    'go'
    'blueprint-compiler'
    'pkgconf'
    'gcc'
    'gobject-introspection'
)
provides=('whatsdown')
conflicts=('whatsdown' 'whatsdown-bin')
source=("git+https://github.com/EmirOven/WhatsDown.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/WhatsDown"
    git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' || printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "$srcdir/WhatsDown"
    export GOPATH="$srcdir/gopath"
    go mod download
}

build() {
    cd "$srcdir/WhatsDown"
    export GOPATH="$srcdir/gopath"
    export CGO_CPPFLAGS="${CPPFLAGS}"
    export CGO_CFLAGS="${CFLAGS}"
    export CGO_CXXFLAGS="${CXXFLAGS}"
    export CGO_LDFLAGS="${LDFLAGS}"
    export GOFLAGS="-buildmode=pie -trimpath -ldflags=-linkmode=external -mod=readonly -modcacherw"

    blueprint-compiler batch-compile ui ui ui/*.blp ui/components/*.blp
    go build -v -o whatsdown .
}

check() {
    cd "$srcdir/WhatsDown"
    go test -short ./...
}

package() {
    cd "$srcdir/WhatsDown"
    install -Dm755 whatsdown "${pkgdir}/usr/bin/whatsdown"
    install -Dm644 com.postbetasoftware.WhatsDown.desktop "${pkgdir}/usr/share/applications/com.postbetasoftware.WhatsDown.desktop"
    install -Dm644 com.postbetasoftware.WhatsDown.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/com.postbetasoftware.WhatsDown.svg"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
